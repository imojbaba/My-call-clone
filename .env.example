# ---- xAI (required) ----
# Create a key at https://console.x.ai
XAI_API_KEY=

# Speech-to-speech model + endpoint (defaults are fine)
GROK_REALTIME_URL=wss://api.x.ai/v1/realtime
GROK_MODEL=grok-voice-latest

# Voices: eve, ara, rex, sal, leo (or a custom cloned voice)
GROK_VOICE=eve

# Your bot's personality/behavior
SYSTEM_INSTRUCTIONS=You are a friendly, helpful voice assistant on a phone call. Keep answers short and conversational. Match the caller's language (Hindi, Hinglish, or English).

# What the bot says when it picks up (leave empty to have the caller speak first)
GREETING=Hello! I'm your Grok-powered assistant. How can I help you today?

# ---- Server ----
PORT=3000
# Set true to log every Grok event type (debugging)
LOG_EVENTS=false

# ---- Twilio (required for phone calls; get these at https://console.twilio.com) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number you bought/got from Twilio, E.164 format e.g. +14155551234
TWILIO_PHONE_NUMBER=
# Public hostname of this server (e.g. your ngrok domain), used for outbound calls
PUBLIC_HOST=your-subdomain.ngrok-free.app
